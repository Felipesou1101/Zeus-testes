<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeusFiscalMonitor.Domain\ZeusFiscalMonitor.Domain.csproj" />
    <ProjectReference Include="..\ZeusFiscalMonitor.Infraestrutura\ZeusFiscalMonitor.Infraestrutura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os mesmos XMLs de exemplo usados na demo: se o schema mudar, os testes acusam. -->
    <None Include="..\..\exemplos\*.xml" Link="Exemplos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
